{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "baseUrl": "./",
    "paths": {
      "@/server/*": ["src/server/*"]
    },
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}

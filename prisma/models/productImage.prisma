model ProductImage {
  id          String   @id @default(uuid())
  imageData   Bytes    // Binary image data stored as bytea in PostgreSQL
  contentType String   // Store the MIME type (e.g., "image/jpeg", "image/png")
  fileName    String?  // Original filename
  fileSize    Int      // Size in bytes
  isPrimary   Boolean  @default(false) // Flag for primary/thumbnail image
  altText     String?  // Alternative text for accessibility
  sortOrder   Int      @default(0)     // For ordering multiple images
  
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}